# 네이버클라우드플랫폼(NCP) Maps Client ID
# 콘솔 > AI·Application Service > Maps > Application 등록에서 발급
VITE_NAVER_CLIENT_ID=

# Firebase 프로젝트 설정 (Firebase 콘솔 > 프로젝트 설정 > 일반 > 내 앱 > SDK 설정 및 구성)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 진행자(호스트) 화면 접속 비밀번호 (게임 시작/초기화 권한)
VITE_HOST_PASSWORD=changeme
